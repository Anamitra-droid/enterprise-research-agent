# Copy to .env and fill in. Without keys the system runs in offline mock mode.

# --- Providers (auto = real provider when the key is present, else mock) ---
OPENROUTER_API_KEY=          # https://openrouter.ai/keys
TAVILY_API_KEY=              # https://tavily.com (free tier)
LLM_PROVIDER=auto            # auto | openrouter | mock
SEARCH_PROVIDER=auto         # auto | tavily | mock
EMBEDDING_PROVIDER=huggingface   # huggingface (local bge-small) | hash (no download; tests)

# Any OpenRouter model id that supports structured outputs (see openrouter.ai/models)
SMART_MODEL=anthropic/claude-sonnet-5.5     # synthesis, conflict detection, judging
FAST_MODEL=anthropic/claude-haiku-5.5       # routing, grading, groundedness checks
# Optional server-side fallbacks if the primary model is unavailable (JSON list)
# OPENROUTER_FALLBACK_MODELS=["anthropic/claude-sonnet-5"]
# Optional attribution shown on openrouter.ai
# OPENROUTER_APP_URL=https://github.com/you/enterprise-research-agent
OPENROUTER_APP_NAME=Enterprise Research Agent

# --- Human-in-the-loop gates ---
HITL_CONFIDENTIAL=true
HITL_LOW_CONFIDENCE=true
HITL_WEB_PRIVACY=true
HITL_KB_WRITES=true
LOW_CONFIDENCE_THRESHOLD=0.45
GROUNDEDNESS_THRESHOLD=0.7

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=false
# Optional LangSmith tracing (no code changes needed)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=enterprise-research-agent
