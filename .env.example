# Copy to .env and fill in. Without keys the system runs in offline mock mode.

# --- Providers (auto = real provider when the key is present, else mock) ---
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
LLM_PROVIDER=auto            # auto | anthropic | mock
SEARCH_PROVIDER=auto         # auto | tavily | mock
EMBEDDING_PROVIDER=huggingface   # huggingface (local bge-small) | hash (no download; tests)

SMART_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
# Server-side refusal fallback beta for Sonnet 5.5. Set false if your account rejects it.
ANTHROPIC_SERVER_FALLBACK=true

# --- Human-in-the-loop gates ---
HITL_CONFIDENTIAL=true
HITL_LOW_CONFIDENCE=true
HITL_WEB_PRIVACY=true
HITL_KB_WRITES=true
LOW_CONFIDENCE_THRESHOLD=0.45
GROUNDEDNESS_THRESHOLD=0.7

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=false
# Optional LangSmith tracing (no code changes needed)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=enterprise-research-agent
